# Slot2 is the explicit private Zero1HP precondition generated by the native
# tests with X3_COOP_LOW_P2_OUTPUT. No death or survivor result is supplied.
wait 10
loadstate 2
wait 10
dump p2-death-before
press right+p2:right 180
press right+p2:right+b+p2:b 60
press right+p2:right 240
wait 10
dump p2-death-after
press right 30
wait 60
dump p2-death-control
savestate 10
quit
