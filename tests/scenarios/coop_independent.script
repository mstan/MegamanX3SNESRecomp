# Native stage1 P2-only approach. Run with the independent simulation profile.
# The camera/activation result is not supplied by this setup; X stays still.
wait 600
press start 6
wait 120
press start 6
wait 120
press start 6
wait 120
press start 6
until 00d1 == 04 1800
until 00d2 == 04 1800
wait 240
poke 1fae 01
poke 1faf 00
poke 1fb3 00
poke 1fb5 00
poke 1fb6 00
poke 1ebf 01
poke 00d1 02
poke 00d2 04
poke 00d3 00
until 00d1 == 04 1800
until 00d2 == 04 1800
until 1f22 == 00 1800
wait 120
press p2:right 150
press p2:right+p2:b+p2:a 60
press p2:right 120
wait 10
dump independent-p2-frontier
savestate 3
quit
